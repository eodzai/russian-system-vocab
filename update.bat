@echo off
chcp 65001 > nul
echo ========================================================
echo   ロシア語単語帳 PWA - ワンクリック更新スクリプト
echo ========================================================
echo.
git add .
set /p msg="コミットメッセージを入力してください (未入力の場合は「Update」): "
if "%msg%"=="" set msg=Update
git commit -m "%msg%"
echo.
echo GitHub に送信中...
git push origin main
echo.
echo ========================================================
echo   更新が完了しました！
echo   1〜2分後にiPhone側で自動的に最新版に反映されます。
echo ========================================================
pause
